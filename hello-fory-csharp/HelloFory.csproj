<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Org.Feuyeux.HelloFory</RootNamespace>
    <AssemblyName>hello-fory-csharp</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Includes the Fory runtime plus the source generator for [ForyStruct] types -->
    <PackageReference Include="Apache.Fory" Version="1.7.2" />
  </ItemGroup>

</Project>
